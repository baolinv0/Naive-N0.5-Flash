            state['trials'].append({'run_id': run_id, 'valid': True, 'recipe': result['recipe']})
            state['frozen'] = {'run_id': run_id, 'recipe': result['recipe']}
            (search / 'campaign.json').write_text(json.dumps(state))
        plan['delta_useful_db'] = threshold
